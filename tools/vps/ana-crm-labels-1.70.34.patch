+// ANA snapshots include real membership and label names, not only aggregate counts.
+function crmLabelSnapshotKey(vendedor, result) {
+  if (String(vendedor || '').toUpperCase().trim() !== 'ANA') {
+    return [...result.payload].sort((a, b) => String(a.id).localeCompare(String(b.id)))
+      .map(e => `${e.id}:${e.count}`).join('|')
+  }
+  // A partial/unknown read is not an empty label set. Preserve the last confirmed snapshot.
+  if (result.labels_confiavel !== true) return null
+  const byKey = (a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b))
+  const catalog = (result.payload || []).map(e => [String(e.id), String(e.name || ''), e.color ?? null, e.count ?? 0]).sort(byKey)

+    [...new Set((c.label_ids || []).map(String))].sort()]).sort(byKey)
+  return JSON.stringify({ v: 1, catalog, chats })
+}
+function crmLabelSnapshotAck(vendedor, result, ack) {
+  if (String(vendedor || '').toUpperCase().trim() !== 'ANA') return true
+  if (result.labels_confiavel !== true || ack?.ok !== true || ack.heartbeat !== false) return false
+  const rows = (result.chats_etiquetas || []).slice(0, 5000)
+    .filter(c => c && typeof c.phone === 'string' && c.phone.length >= 10 && Array.isArray(c.label_ids))
+  return ack.chat_labels_raw === (result.chats_etiquetas || []).length
+    && ack.chat_labels_filtered === rows.length && ack.chat_labels === rows.length

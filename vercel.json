{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/gerar-pdf.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/gerar-pdf-roteiro.ts": {
      "memory": 1536,
      "maxDuration": 90
    },
    "api/rota.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://flwbeevtvjiouxdjmziv.supabase.co https://*.supabase.co wss://flwbeevtvjiouxdjmziv.supabase.co wss://*.supabase.co https://nominatim.openstreetmap.org; frame-ancestors 'self' https://web.whatsapp.com chrome-extension://*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.whatsapp.com chrome-extension://*"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(self), payment=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
